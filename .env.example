# ============ DeepSeek AI ============
# 主模型（通用对话，便宜）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 推理模型（质检/打分场景可选）
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ============ 代理接口鉴权 ============
# /api/ai/generate 与 /api/ai/stream 的共享密钥（X-Api-Key 必须相等）
# 任意强随机字符串，与前端「设置 → AI 配置 → 代理接口密钥」保持一致
PROXY_API_SECRET=change-me-to-a-long-random-string

# ============ Supabase ============
# 服务端用（Vercel Function 通过 service_role 直连 DB，绕过 RLS）
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxx

# 前端用（暴露给浏览器，配合 RLS，只能读写本人数据）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

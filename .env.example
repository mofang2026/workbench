# ============ DeepSeek AI ============
# 主模型（通用对话，便宜）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 推理模型（质检/打分场景可选）
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ============ 代理接口鉴权 ============
# /api/ai/generate 与 /api/ai/stream 的共享密钥（X-Api-Key 必须相等）
# 任意强随机字符串，与前端「设置 → AI 配置 → 代理接口密钥」保持一致
PROXY_API_SECRET=change-me-to-a-long-random-string

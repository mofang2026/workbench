# ============ workbench-api 服务端环境变量（部署到 /opt/workbench-api/.env） ============
# 部署后请 chmod 600 /opt/workbench-api/.env，密钥只在服务器上，不进前端。
# 按需配置：至少配一个提供商（必须有对应 *_API_KEY），否则 /api/ai/* 返回 500。

PORT=3790
HOST=127.0.0.1

# ---------- DeepSeek（主） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---------- 智谱 AI ----------
#ZHIPU_API_KEY=xxx.xxx
#ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#ZHIPU_MODEL=glm-4-plus
#ZHIPU_REASONER_MODEL=glm-4-plus

# ---------- 月之暗面 Kimi ----------
#MOONSHOT_API_KEY=sk-xxx
#MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
#MOONSHOT_MODEL=moonshot-v1-8k
#MOONSHOT_REASONER_MODEL=moonshot-v1-8k

# ---------- 自定义（OpenAI 兼容） ----------
#CUSTOM_AI_API_KEY=sk-xxx
#CUSTOM_AI_BASE_URL=https://api.openai.com/v1
#CUSTOM_AI_MODEL=gpt-4o-mini
#CUSTOM_AI_REASONER_MODEL=gpt-4o-mini

# ============ 代理接口鉴权（fail-closed） ============
# 必须与浏览器「设置 → AI 配置 → 代理接口密钥」中的值完全一致，
# 否则前端 /api/ai/* 请求会返回 401。
PROXY_API_SECRET=change-me-to-a-long-random-string